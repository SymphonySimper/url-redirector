{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		/* compile.ts runs under node, and imports src modules with explicit .ts extensions. */
		"types": ["node", "./worker-configuration.d.ts"],
		"allowImportingTsExtensions": true,
		/* node only strips types, so the script must not use syntax that needs emit. */
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["scripts/**/*.ts"]
}
